{
  "expo": {
    "name": "Daily Routine",
    "slug": "daily-routine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily-routine",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/images/icon.png", "resizeMode": "contain", "backgroundColor": "#F5FBF7" },
    "ios": { "supportsTablet": false },
    "android": {},
    "web": { "favicon": "./assets/images/icon.png" },
    "plugins": ["expo-router", ["expo-notifications", { "icon": "./assets/images/icon.png", "color": "#3E8D6B" }]],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
